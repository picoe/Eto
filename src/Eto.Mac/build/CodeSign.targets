<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="15.0" >

  <PropertyGroup>
    <!-- Search key for the code signing identity for the .app (partial strings match)
         If empty, this will use the code signing identity if only a single identity is installed.
     -->
    <CodeSigningKey Condition="$(CodeSigningKey) == ''"></CodeSigningKey>
    <!-- Search key for the code signing identity for the .dmg (partial strings match) -->
    <DmgCodeSigningKey Condition="$(DmgCodeSigningKey) == ''">$(CodeSigningKey)</DmgCodeSigningKey>
    <!-- Search key for the installer signing identity for the .pkg (partial strings match), which needs a Developer ID Installer certificate -->
    <PkgCodeSigningKey Condition="$(PkgCodeSigningKey) == ''">Developer ID Installer</PkgCodeSigningKey>
    <!-- Code signing entitlements to use -->
    <CodeSignEntitlements Condition="$(CodeSignEntitlements) == ''">$(MSBuildThisFileDirectory)CodeSign.entitlements</CodeSignEntitlements>
  </PropertyGroup>

  <PropertyGroup>
    <MacBuildDmgDependsOnTargets>MacCodeSignApp;$(MacBuildDmgDependsOnTargets)</MacBuildDmgDependsOnTargets>
    <MacBuildPkgDependsOnTargets>MacCodeSignApp;$(MacBuildPkgDependsOnTargets)</MacBuildPkgDependsOnTargets>
  </PropertyGroup>

  <Target Name="MacCodeSign" AfterTargets="MacBuildAppBundle" DependsOnTargets="$(MacCodeSignDependsOnTargets)">
  </Target>

  <Target Name="MacCodeSignApp" DependsOnTargets="MacBuildAppBundle">

    <MSBuild Projects="$(MSBuildThisFileFullPath)" Targets="_MacResolveCodeSignIdentity" Properties="CodeSignSearchKey=$(CodeSigningKey)" >
      <Output TaskParameter="TargetOutputs" PropertyName="ResolvedCodeSigningKey" />
    </MSBuild>

    <PropertyGroup>
      <CodeSignEntitlements Condition="$(CodeSignEntitlements) != '' AND !Exists($(CodeSignEntitlements)) AND Exists('$(MSBuildProjectDirectory)\$(CodeSignEntitlements)')">$(MSBuildProjectDirectory)\$(CodeSignEntitlements)</CodeSignEntitlements>

      <_CodeSignOptions Condition="$(CodeSignEntitlements) != ''">--entitlements "$(CodeSignEntitlements)"</_CodeSignOptions>
    </PropertyGroup>

    <ItemGroup>
      <_CodeSignFiles Include="$(OutputAppPath)" CodeSignOptions="--deep --options runtime $(_CodeSignOptions)" />
    </ItemGroup>

    <Exec Command='codesign --force %(_CodeSignFiles.CodeSignOptions) --sign "$(ResolvedCodeSigningKey)" "@(_CodeSignFiles)"' />

    <Message Text="Code signed $(OutputAppPath)" Importance="high" />
  </Target>

  <Target Name="MacCodeSignDmg" DependsOnTargets="MacBuildDmg" Condition="$(_MacBuildDmg) == 'True'">

    <MSBuild Projects="$(MSBuildThisFileFullPath)" Targets="_MacResolveCodeSignIdentity" Properties="CodeSignSearchKey=$(DmgCodeSigningKey)" >
      <Output TaskParameter="TargetOutputs" PropertyName="ResolvedDmgCodeSigningKey" />
    </MSBuild>

    <Exec Command='codesign --force --sign "$(ResolvedDmgCodeSigningKey)" "$(_DmgPath)"' />
    
    <Message Text="Code signed $(_DmgPath)" Importance="high" />
  </Target>

  <Target Name="MacCodeSignPkg" DependsOnTargets="MacBuildPkg" Condition="$(_MacBuildPkg) == 'True'">

    <!-- installer certificates aren't valid for the codesigning policy, so search all identities.
         productsign only takes the certificate name, not its SHA-1 -->
    <MSBuild Projects="$(MSBuildThisFileFullPath)" Targets="_MacResolveCodeSignIdentity" Properties="CodeSignSearchKey=$(PkgCodeSigningKey);CodeSignPolicy=basic;CodeSignResolveName=True" >
      <Output TaskParameter="TargetOutputs" PropertyName="ResolvedPkgCodeSigningKey" />
    </MSBuild>

    <PropertyGroup>
      <_UnsignedPkgPath>$(_MacPkgTempPath)$(PkgName).unsigned.pkg</_UnsignedPkgPath>
    </PropertyGroup>

    <Move SourceFiles="$(_PkgPath)" DestinationFiles="$(_UnsignedPkgPath)" />
    <Exec Command='productsign --sign "$(ResolvedPkgCodeSigningKey)" "$(_UnsignedPkgPath)" "$(_PkgPath)"' />

    <Message Text="Code signed $(_PkgPath)" Importance="high" />
  </Target>

  <!-- Resolve a code sign identity's SHA-1, or its name with CodeSignResolveName=True.  Parameters: CodeSignSearchKey, CodeSignPolicy, CodeSignResolveName -->
  <Target Name="_MacResolveCodeSignIdentity" Outputs="$(ResolvedCodeSignIdentity)">
    <PropertyGroup>
      <CodeSignPolicy Condition="$(CodeSignPolicy) == ''">codesigning</CodeSignPolicy>
    </PropertyGroup>

    <!-- get valid identities that match, as "<sha1> <name>" (the leading "1)" index is stripped) -->
    <Exec Command="security find-identity -v -p $(CodeSignPolicy) | grep -v 'valid identities found' | grep '$(CodeSignSearchKey)' | sed -e 's/^[[:space:]]*[0-9][0-9]*)[[:space:]]*//'"
          ConsoleToMSBuild="True"
          StandardOutputImportance="normal">
        <Output TaskParameter="ConsoleOutput" ItemName="MatchingIdentities"/>
    </Exec>

    <Error Text="Could not find code sign key matching '$(CodeSignSearchKey)'. Ensure you have installed your code sign certificate."
           Condition="@(MatchingIdentities->Count()) == '0'" />

    <Error Text="More than one valid code signing certificate matches '$(CodeSignSearchKey)':%0A%0A@(MatchingIdentities->'    %(Identity)', '%0A')%0A%0ASet CodeSigningKey (or DmgCodeSigningKey for the .dmg, PkgCodeSigningKey for the .pkg) to something that matches only one of the above - any part of the certificate name, or its full SHA-1 - either in your project or on the command line, eg:%0A%0A    dotnet build /p:CodeSigningKey=&quot;Developer ID Application: Your Name (TEAMID)&quot;"
           Condition="@(MatchingIdentities->Count()) > '1'" />

    <PropertyGroup>
      <_MatchedIdentity>@(MatchingIdentities)</_MatchedIdentity>
      <ResolvedCodeSignIdentity Condition="$(CodeSignResolveName) != 'True'">$([System.Text.RegularExpressions.Regex]::Match($(_MatchedIdentity), '[0-9A-F]{40}').Value)</ResolvedCodeSignIdentity>
      <ResolvedCodeSignIdentity Condition="$(CodeSignResolveName) == 'True'">$([System.Text.RegularExpressions.Regex]::Match($(_MatchedIdentity), '(?&lt;=")[^"]+(?=")').Value)</ResolvedCodeSignIdentity>
    </PropertyGroup>
  </Target>

</Project>