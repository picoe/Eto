<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="15.0">

  <!--
    Creates Windows installers for the app, enabled by setting WindowsPackageFormats.

    Formats:
      msi    Windows Installer package. Installs with a progress bar, adds a Start menu shortcut and an entry
             in Installed apps, and replaces any older version. Stops if the .NET runtime the app needs is missing.
      setup  Setup.exe that downloads and installs the .NET runtime the app needs when it's missing, then
             installs the msi it contains. Arguments are passed on to msiexec, e.g. /quiet.

    Both are created on Windows with tools that come with it, so nothing else needs installing.
    Apps for .NET Framework, or that include .NET (WindowsPackageSelfContained), don't need setup.

    Everything below is optional; most values come from the usual project properties.
  -->

  <PropertyGroup>
    <_WindowsPackageImported>True</_WindowsPackageImported>

    <!-- Create the installers after each Release build. Set to False to only create them with -t:WindowsPackage -->
    <WindowsPackageOnBuild Condition="'$(WindowsPackageOnBuild)' == '' AND '$(Configuration)' == 'Release'">True</WindowsPackageOnBuild>

    <!-- Start of the installers' file names. Defaults to the title without spaces -->
    <WindowsPackageName Condition="'$(WindowsPackageName)' == ''"></WindowsPackageName>
    <!-- Name shown in Installed apps and on the shortcuts. Defaults to Product -->
    <WindowsPackageTitle Condition="'$(WindowsPackageTitle)' == ''"></WindowsPackageTitle>
    <!-- Defaults to Version. Windows Installer only uses the first three numbers, up to 255.255.65535 -->
    <WindowsPackageVersion Condition="'$(WindowsPackageVersion)' == ''"></WindowsPackageVersion>
    <!-- Publisher shown in Installed apps. Defaults to Company, then Authors -->
    <WindowsPackageManufacturer Condition="'$(WindowsPackageManufacturer)' == ''"></WindowsPackageManufacturer>
    <!-- Defaults to Description. The first line is shown in Installed apps and on the shortcuts -->
    <WindowsPackageDescription Condition="'$(WindowsPackageDescription)' == ''"></WindowsPackageDescription>
    <!-- Defaults to PackageProjectUrl -->
    <WindowsPackageHomepage Condition="'$(WindowsPackageHomepage)' == ''">$(PackageProjectUrl)</WindowsPackageHomepage>
    <!-- GUID that identifies the app across versions, so installing a new one replaces the old.
         Defaults to one made from the assembly name, so set it before renaming the assembly -->
    <WindowsPackageUpgradeCode Condition="'$(WindowsPackageUpgradeCode)' == ''"></WindowsPackageUpgradeCode>
    <!-- perUser installs to %LocalAppData%\Programs without asking for admin rights,
         perMachine installs to Program Files for everyone -->
    <WindowsPackageScope Condition="'$(WindowsPackageScope)' == ''">perUser</WindowsPackageScope>
    <!-- Folder to install into under Programs or Program Files, e.g. My Company\My App. Defaults to the title -->
    <WindowsPackageInstallFolder Condition="'$(WindowsPackageInstallFolder)' == ''"></WindowsPackageInstallFolder>
    <!-- Add a desktop shortcut as well as the Start menu one -->
    <WindowsPackageDesktopShortcut Condition="'$(WindowsPackageDesktopShortcut)' == ''">False</WindowsPackageDesktopShortcut>
    <!-- Where the installers are created. Defaults to the build output folder -->
    <WindowsPackageOutputPath Condition="'$(WindowsPackageOutputPath)' == ''"></WindowsPackageOutputPath>
    <!-- Include .pdb files in the installers -->
    <WindowsPackageIncludeSymbols Condition="'$(WindowsPackageIncludeSymbols)' == ''">False</WindowsPackageIncludeSymbols>
    <!-- .ico shown in Installed apps and for Setup.exe. Defaults to ApplicationIcon, otherwise the app's own icon is used -->
    <WindowsIcon Condition="'$(WindowsIcon)' == ''">$(ApplicationIcon)</WindowsIcon>

    <!-- Include .NET in the installers instead of needing it installed. Defaults to SelfContained -->
    <WindowsPackageSelfContained Condition="'$(WindowsPackageSelfContained)' == ''">$(SelfContained)</WindowsPackageSelfContained>
    <WindowsPackageSelfContained Condition="'$(WindowsPackageSelfContained)' == ''">False</WindowsPackageSelfContained>
    <!-- Runtime identifiers to create installers for .NET apps for, e.g. win-x64;win-arm64.
         Defaults to RuntimeIdentifier when it's a Windows one, otherwise the architecture of the build machine -->
    <WindowsPackageRuntimeIdentifiers Condition="'$(WindowsPackageRuntimeIdentifiers)' == '' AND $(RuntimeIdentifier.StartsWith('win-'))">$(RuntimeIdentifier)</WindowsPackageRuntimeIdentifiers>
    <WindowsPackageRuntimeIdentifiers Condition="'$(WindowsPackageRuntimeIdentifiers)' == '' AND $([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture) == 'Arm64'">win-arm64</WindowsPackageRuntimeIdentifiers>
    <WindowsPackageRuntimeIdentifiers Condition="'$(WindowsPackageRuntimeIdentifiers)' == ''">win-x64</WindowsPackageRuntimeIdentifiers>
    <!-- restored with the app, as restoring them while packaging would rewrite the restore results other target frameworks are building with -->
    <RuntimeIdentifiers>$(RuntimeIdentifiers);$(WindowsPackageRuntimeIdentifiers)</RuntimeIdentifiers>
    <!-- Stop the msi from installing when the .NET runtime the app needs is missing -->
    <WindowsPackageCheckRuntime Condition="'$(WindowsPackageCheckRuntime)' == ''">True</WindowsPackageCheckRuntime>
  </PropertyGroup>

  <!--
    Code signing, done when a certificate or WindowsSignCommand is set. Signs the app's executable and assembly
    before they're packaged, then the msi, then setup, so Windows shows who they're from instead of warning
    about an unknown publisher.
  -->
  <PropertyGroup>
    <!-- .pfx file with the certificate. Keep the password out of the project file, e.g. in an environment variable -->
    <WindowsSignCertificateFile Condition="'$(WindowsSignCertificateFile)' == ''"></WindowsSignCertificateFile>
    <WindowsSignCertificatePassword Condition="'$(WindowsSignCertificatePassword)' == ''"></WindowsSignCertificatePassword>
    <!-- Or the thumbprint of a certificate installed in your certificate store, e.g. one on a hardware token -->
    <WindowsSignCertificateThumbprint Condition="'$(WindowsSignCertificateThumbprint)' == ''"></WindowsSignCertificateThumbprint>
    <!-- Server that adds the time of signing, so signatures stay valid after the certificate expires.
         Your certificate's provider has one, e.g. http://timestamp.digicert.com -->
    <WindowsSignTimestampUrl Condition="'$(WindowsSignTimestampUrl)' == ''"></WindowsSignTimestampUrl>
    <!-- Or your own command that signs the files added to its end, e.g. for a cloud signing service:
         signtool sign /v /fd SHA256 /tr http://timestamp.acs.microsoft.com /td SHA256 /dlib path\Azure.CodeSigning.Dlib.dll /dmdf metadata.json -->
    <WindowsSignCommand Condition="'$(WindowsSignCommand)' == ''"></WindowsSignCommand>
    <!-- signtool.exe, which comes with the Windows SDK. Defaults to the newest one installed -->
    <WindowsSignToolPath Condition="'$(WindowsSignToolPath)' == ''"></WindowsSignToolPath>
  </PropertyGroup>

  <!--
    Items you can add:

    WindowsPackageContent: Extra files to install. TargetPath is relative to the install folder,
      and defaults to the file's RecursiveDir and name.
    WindowsPackageSignFile: Other published files to sign, relative to the install folder (no wildcards),
      e.g. your own libraries.
  -->
  <ItemGroup>
    <AvailableItemName Include="WindowsPackageContent" />
  </ItemGroup>

  <UsingTask TaskName="Eto.Windows.Build.WriteMsiPackage" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task><Code Type="Class" Source="$(MSBuildThisFileDirectory)WindowsPackage.cs" /></Task>
  </UsingTask>
  <UsingTask TaskName="Eto.Windows.Build.GetRuntimeFrameworks" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task><Code Type="Class" Source="$(MSBuildThisFileDirectory)WindowsPackage.cs" /></Task>
  </UsingTask>
  <UsingTask TaskName="Eto.Windows.Build.WriteSetupInfo" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task><Code Type="Class" Source="$(MSBuildThisFileDirectory)WindowsPackage.cs" /></Task>
  </UsingTask>

  <Target Name="_WindowsPackageOnBuild" AfterTargets="Build" DependsOnTargets="WindowsPackage"
          Condition="'$(WindowsPackageOnBuild)' == 'True' AND '$(TargetFramework)' != '' AND '$(_WindowsIsPackaging)' != 'True' AND $([MSBuild]::IsOSPlatform(Windows)) AND ('$(OutputType)' == 'WinExe' OR '$(OutputType)' == 'Exe')" />

  <!-- Creates the installers in WindowsPackageFormats -->
  <Target Name="WindowsPackage" DependsOnTargets="_WindowsPackageInit;_WindowsPackageCreate;_WindowsPackagePerRuntime" />

  <!-- Paths aren't final when this file is imported, so work everything out once the build is running -->
  <Target Name="_WindowsPackageInit">
    <Error Text="Windows installers can only be created on Windows." Condition="!$([MSBuild]::IsOSPlatform(Windows))" />
    <Error Text="Windows installers can only be created for .NET or .NET Framework apps, not $(TargetFramework)."
           Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp' AND '$(TargetFrameworkIdentifier)' != '.NETFramework'" />
    <ItemGroup>
      <_WindowsPackageFormat Include="$(WindowsPackageFormats)" />
    </ItemGroup>
    <Warning Text="Unknown Windows package format '%(_WindowsPackageFormat.Identity)'. Use msi or setup."
             Condition="!$([System.String]::Copy(';msi;setup;').Contains(';$([System.String]::Copy('%(_WindowsPackageFormat.Identity)').Trim().ToLowerInvariant());'))" />
    <Error Text="WindowsPackageScope must be perUser or perMachine, not $(WindowsPackageScope)."
           Condition="'$(WindowsPackageScope)' != 'perUser' AND '$(WindowsPackageScope)' != 'perMachine'" />

    <PropertyGroup>
      <_WindowsFormats>;$(WindowsPackageFormats.ToLowerInvariant().Replace(' ', ''));</_WindowsFormats>
      <_WindowsBuildMsi Condition="$(_WindowsFormats.Contains(';msi;'))">True</_WindowsBuildMsi>
      <_WindowsBuildSetup Condition="$(_WindowsFormats.Contains(';setup;'))">True</_WindowsBuildSetup>
      <_WindowsIsNetCore Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">True</_WindowsIsNetCore>

      <_WindowsTitle>$(WindowsPackageTitle)</_WindowsTitle>
      <_WindowsTitle Condition="'$(_WindowsTitle)' == ''">$(Product)</_WindowsTitle>
      <_WindowsTitle Condition="'$(_WindowsTitle)' == ''">$(AssemblyName)</_WindowsTitle>
      <_WindowsName>$(WindowsPackageName)</_WindowsName>
      <_WindowsName Condition="'$(_WindowsName)' == ''">$(_WindowsTitle.Replace(' ', ''))</_WindowsName>
      <_WindowsVersion>$(WindowsPackageVersion)</_WindowsVersion>
      <_WindowsVersion Condition="'$(_WindowsVersion)' == ''">$(Version)</_WindowsVersion>
      <_WindowsVersion Condition="'$(_WindowsVersion)' == ''">1.0.0</_WindowsVersion>
      <_WindowsDescription>$(WindowsPackageDescription)</_WindowsDescription>
      <_WindowsDescription Condition="'$(_WindowsDescription)' == '' AND '$(Description)' != 'Package Description'">$(Description)</_WindowsDescription>
      <_WindowsManufacturer>$(WindowsPackageManufacturer)</_WindowsManufacturer>
      <_WindowsManufacturer Condition="'$(_WindowsManufacturer)' == ''">$(Company)</_WindowsManufacturer>
      <_WindowsManufacturer Condition="'$(_WindowsManufacturer)' == '' AND '$(Authors)' != '$(AssemblyName)'">$(Authors)</_WindowsManufacturer>
      <_WindowsInstallFolder>$(WindowsPackageInstallFolder)</_WindowsInstallFolder>
      <_WindowsInstallFolder Condition="'$(_WindowsInstallFolder)' == ''">$(_WindowsTitle)</_WindowsInstallFolder>
      <_WindowsSelfContained>$(WindowsPackageSelfContained)</_WindowsSelfContained>
      <_WindowsSelfContained Condition="'$(_WindowsIsNetCore)' != 'True'">False</_WindowsSelfContained>

      <!-- .NET Framework apps are packaged here; .NET apps by an instance of this project for each runtime identifier -->
      <_WindowsBuildHere Condition="'$(_WindowsIsNetCore)' != 'True'">True</_WindowsBuildHere>
      <_WindowsBuildHere Condition="'$(_WindowsIsNetCore)' == 'True' AND '$(_WindowsRid)' != ''">True</_WindowsBuildHere>

      <!-- a .NET Framework app runs as whatever it was built for, and AnyCPU as x64 on 64 bit Windows -->
      <_WindowsArch Condition="'$(_WindowsRid)' == 'win-x64'">x64</_WindowsArch>
      <_WindowsArch Condition="'$(_WindowsRid)' == 'win-arm64'">arm64</_WindowsArch>
      <_WindowsArch Condition="'$(_WindowsRid)' == 'win-x86'">x86</_WindowsArch>
      <_WindowsArch Condition="'$(_WindowsIsNetCore)' != 'True' AND '$(PlatformTarget)' == 'x86'">x86</_WindowsArch>
      <_WindowsArch Condition="'$(_WindowsIsNetCore)' != 'True' AND '$(PlatformTarget)' == 'ARM64'">arm64</_WindowsArch>
      <_WindowsArch Condition="'$(_WindowsIsNetCore)' != 'True' AND '$(_WindowsArch)' == ''">x64</_WindowsArch>
      <_WindowsFileSuffix Condition="'$(_WindowsIsNetCore)' == 'True'">-$(_WindowsArch)</_WindowsFileSuffix>

      <_WindowsTempPath>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'winpkg'))</_WindowsTempPath>
      <_WindowsWorkPath>$(_WindowsTempPath)</_WindowsWorkPath>
      <_WindowsWorkPath Condition="'$(_WindowsRid)' != ''">$(_WindowsTempPath)$(_WindowsRid)\</_WindowsWorkPath>
      <_WindowsOutputPath>$(WindowsPackageOutputPath)</_WindowsOutputPath>
      <_WindowsOutputPath Condition="'$(_WindowsOutputPath)' == ''">$(OutputPath)</_WindowsOutputPath>
      <_WindowsOutputPath>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(_WindowsOutputPath)'))</_WindowsOutputPath>

      <_WindowsMsiFile>$(_WindowsOutputPath)$(_WindowsName)-$(_WindowsVersion)$(_WindowsFileSuffix).msi</_WindowsMsiFile>
      <!-- setup on its own still needs an msi to contain -->
      <_WindowsMsiFile Condition="'$(_WindowsBuildMsi)' != 'True'">$(_WindowsWorkPath)$(_WindowsName)-$(_WindowsVersion)$(_WindowsFileSuffix).msi</_WindowsMsiFile>
      <_WindowsSetupFile>$(_WindowsOutputPath)$(_WindowsName)-$(_WindowsVersion)$(_WindowsFileSuffix)-Setup.exe</_WindowsSetupFile>
    </PropertyGroup>

    <Error Text="Windows installers can't be created for $(_WindowsRid)." Condition="'$(_WindowsRid)' != '' AND '$(_WindowsArch)' == ''" />

    <!-- each runtime's instance shares this folder with the main build -->
    <RemoveDir Directories="$(_WindowsTempPath)" Condition="'$(_WindowsRid)' == ''" />
    <MakeDir Directories="$(_WindowsOutputPath)" />
  </Target>

  <Target Name="_WindowsPackageCreate" Condition="'$(_WindowsBuildHere)' == 'True' AND ('$(_WindowsBuildMsi)' == 'True' OR '$(_WindowsBuildSetup)' == 'True')"
          DependsOnTargets="_WindowsPackageInit;_WindowsPublish;_WindowsPackageMsi;_WindowsPackageSetup" />

  <!-- Publishes the app: in process for .NET Framework, or for this instance's runtime identifier -->
  <Target Name="_WindowsPublish" DependsOnTargets="_WindowsPackageInit">
    <PropertyGroup>
      <_WindowsPublishDir>$(_WindowsWorkPath)publish\</_WindowsPublishDir>
      <_WindowsDotNet>$(DOTNET_HOST_PATH)</_WindowsDotNet>
      <_WindowsDotNet Condition="'$(_WindowsDotNet)' == ''">dotnet</_WindowsDotNet>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish" Condition="'$(_WindowsIsNetCore)' != 'True'"
             Properties="_WindowsIsPackaging=True;Configuration=$(Configuration);TargetFramework=$(TargetFramework);PublishReferencesDocumentationFiles=False;PublishDir=$(_WindowsPublishDir)" />

    <!-- A separate process, which doesn't get this build's global properties, so pass the ones that decide where the
         already compiled referenced projects are and what version the app is. It doesn't restore, as the runtime
         identifiers were restored with the app (see RuntimeIdentifiers above). -->
    <Exec Condition="'$(_WindowsIsNetCore)' == 'True'" Command="&quot;$(_WindowsDotNet)&quot; publish &quot;$(MSBuildProjectFullPath)&quot; -nologo --no-restore --no-dependencies -c &quot;$(Configuration)&quot; -f &quot;$(TargetFramework)&quot; -r &quot;$(_WindowsRid)&quot; --self-contained $(_WindowsSelfContained.ToLowerInvariant()) -o &quot;$([System.IO.Path]::GetDirectoryName('$(_WindowsPublishDir)'))&quot; -p:BuildProjectReferences=False &quot;-p:Platform=$(Platform)&quot; -p:_WindowsIsPackaging=True -p:PublishReferencesDocumentationFiles=False &quot;-p:Version=$(Version)&quot; &quot;-p:AssemblyVersion=$(AssemblyVersion)&quot; &quot;-p:FileVersion=$(FileVersion)&quot; &quot;-p:InformationalVersion=$(InformationalVersion)&quot;" />
    <ItemGroup>
      <_WindowsPublished Include="$(_WindowsPublishDir)**\*" />
      <_WindowsPublished Remove="$(_WindowsPublishDir)**\*.pdb" Condition="'$(WindowsPackageIncludeSymbols)' != 'True'" />
      <_WindowsFiles Include="@(_WindowsPublished)" TargetPath="%(RecursiveDir)%(Filename)%(Extension)" />
      <_WindowsFiles Include="@(WindowsPackageContent)" Condition="'%(WindowsPackageContent.TargetPath)' == ''" TargetPath="%(RecursiveDir)%(Filename)%(Extension)" />
      <_WindowsFiles Include="@(WindowsPackageContent)" Condition="'%(WindowsPackageContent.TargetPath)' != ''" />
    </ItemGroup>
  </Target>

  <!-- Works out how to sign the files, when signing is set up -->
  <Target Name="_WindowsSignInit" DependsOnTargets="_WindowsPackageInit">
    <PropertyGroup>
      <_WindowsSign Condition="'$(WindowsSignCertificateFile)' != '' OR '$(WindowsSignCertificateThumbprint)' != '' OR '$(WindowsSignCommand)' != ''">True</_WindowsSign>
      <_WindowsSignToolArch>x64</_WindowsSignToolArch>
      <_WindowsSignToolArch Condition="$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture) == 'Arm64'">arm64</_WindowsSignToolArch>
    </PropertyGroup>
    <ItemGroup Condition="'$(_WindowsSign)' == 'True' AND '$(WindowsSignCommand)' == '' AND '$(WindowsSignToolPath)' == ''">
      <_WindowsSignTool Include="$(MSBuildProgramFiles32)\Windows Kits\10\bin\10.*\$(_WindowsSignToolArch)\signtool.exe" />
      <_WindowsSignTool Include="$(MSBuildProgramFiles32)\Windows Kits\10\bin\10.*\x64\signtool.exe" Condition="'@(_WindowsSignTool)' == ''" />
    </ItemGroup>
    <PropertyGroup Condition="'@(_WindowsSignTool)' != ''">
      <!-- the SDK folders are named by version, so the last one is the newest -->
      <_WindowsFoundSignTool>%(_WindowsSignTool.FullPath)</_WindowsFoundSignTool>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_WindowsSign)' == 'True' AND '$(WindowsSignCommand)' == ''">
      <_WindowsSignToolPath>$(WindowsSignToolPath)</_WindowsSignToolPath>
      <_WindowsSignToolPath Condition="'$(_WindowsSignToolPath)' == ''">$(_WindowsFoundSignTool)</_WindowsSignToolPath>
      <_WindowsSignToolPath Condition="'$(_WindowsSignToolPath)' == ''">signtool.exe</_WindowsSignToolPath>
      <_WindowsSignCommand>&quot;$(_WindowsSignToolPath)&quot; sign /fd SHA256</_WindowsSignCommand>
      <_WindowsSignCommand Condition="'$(WindowsSignCertificateFile)' != ''">$(_WindowsSignCommand) /f &quot;$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(WindowsSignCertificateFile)'))&quot;</_WindowsSignCommand>
      <_WindowsSignCommand Condition="'$(WindowsSignCertificatePassword)' != ''">$(_WindowsSignCommand) /p &quot;$(WindowsSignCertificatePassword)&quot;</_WindowsSignCommand>
      <_WindowsSignCommand Condition="'$(WindowsSignCertificateThumbprint)' != ''">$(_WindowsSignCommand) /sha1 $(WindowsSignCertificateThumbprint.Replace(' ', ''))</_WindowsSignCommand>
      <_WindowsSignCommand Condition="'$(WindowsSignTimestampUrl)' != ''">$(_WindowsSignCommand) /tr &quot;$(WindowsSignTimestampUrl)&quot; /td SHA256</_WindowsSignCommand>
      <!-- shown as the program's name when Windows asks whether to install it -->
      <_WindowsSignCommand>$(_WindowsSignCommand) /d &quot;$(_WindowsTitle)&quot;</_WindowsSignCommand>
      <_WindowsSignCommand Condition="'$(WindowsPackageHomepage)' != ''">$(_WindowsSignCommand) /du &quot;$(WindowsPackageHomepage)&quot;</_WindowsSignCommand>
    </PropertyGroup>
    <PropertyGroup Condition="'$(WindowsSignCommand)' != ''">
      <_WindowsSignCommand>$(WindowsSignCommand)</_WindowsSignCommand>
    </PropertyGroup>
    <Error Text="Set either WindowsSignCertificateFile or WindowsSignCertificateThumbprint, not both." Condition="'$(WindowsSignCertificateFile)' != '' AND '$(WindowsSignCertificateThumbprint)' != ''" />
    <Error Text="signtool.exe wasn't found. Install the Windows SDK, or set WindowsSignToolPath." Condition="'$(_WindowsSign)' == 'True' AND '$(WindowsSignCommand)' == '' AND '$(_WindowsSignToolPath)' == 'signtool.exe' AND '$(WindowsSignToolPath)' == ''" />
    <Warning Text="The installers will be signed without a timestamp, so their signatures stop being valid when the certificate expires. Set WindowsSignTimestampUrl."
             Condition="'$(_WindowsSign)' == 'True' AND '$(WindowsSignCommand)' == '' AND '$(WindowsSignTimestampUrl)' == ''" />
  </Target>

  <!-- Signs the app before it's packaged, as changing the files afterwards would break the msi -->
  <Target Name="_WindowsSignApp" Condition="'$(_WindowsSign)' == 'True'" DependsOnTargets="_WindowsPublish">
    <ItemGroup>
      <_WindowsSignAppFile Include="$(_WindowsPublishDir)$(AssemblyName).exe" />
      <_WindowsSignAppFile Include="$(_WindowsPublishDir)$(TargetFileName)" Condition="'$(TargetFileName)' != '$(AssemblyName).exe'" />
      <_WindowsSignAppFile Include="@(WindowsPackageSignFile->'$(_WindowsPublishDir)%(Identity)')" />
      <_WindowsSignAppFile Remove="@(_WindowsSignAppFile)" Condition="!Exists('%(FullPath)')" />
    </ItemGroup>
    <Error Text="%(WindowsPackageSignFile.Identity) can't be signed, as it isn't in the published app." Condition="'@(WindowsPackageSignFile)' != '' AND !Exists('$(_WindowsPublishDir)%(WindowsPackageSignFile.Identity)')" />
    <Message Text="Signing @(_WindowsSignAppFile->'%(Filename)%(Extension)', ', ')" Importance="high" />
    <!-- the command can have a password in it, so don't log it -->
    <Exec Command="$(_WindowsSignCommand) @(_WindowsSignAppFile->'&quot;%(FullPath)&quot;', ' ')" EchoOff="True" StandardOutputImportance="low" />
  </Target>

  <Target Name="_WindowsPackageMsi" DependsOnTargets="_WindowsPublish;_WindowsSignInit;_WindowsSignApp">
    <GetRuntimeFrameworks Condition="'$(_WindowsIsNetCore)' == 'True' AND '$(_WindowsSelfContained)' != 'True'"
                          RuntimeConfigFile="$(_WindowsPublishDir)$(AssemblyName).runtimeconfig.json">
      <Output TaskParameter="Frameworks" ItemName="_WindowsFramework" />
    </GetRuntimeFrameworks>
    <PropertyGroup>
      <_WindowsIconFile Condition="'$(WindowsIcon)' != '' AND $(WindowsIcon.ToLowerInvariant().EndsWith('.ico'))">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(WindowsIcon)'))</_WindowsIconFile>
    </PropertyGroup>
    <ItemGroup>
      <_WindowsCheckFramework Include="@(_WindowsFramework)" Condition="'$(WindowsPackageCheckRuntime)' == 'True'" />
    </ItemGroup>
    <WriteMsiPackage Files="@(_WindowsFiles)"
                     MainExecutable="$(AssemblyName).exe"
                     ProductName="$(_WindowsTitle)"
                     Version="$(_WindowsVersion)"
                     Manufacturer="$(_WindowsManufacturer)"
                     Description="$(_WindowsDescription)"
                     Homepage="$(WindowsPackageHomepage)"
                     UpgradeCode="$(WindowsPackageUpgradeCode)"
                     AppId="$(AssemblyName)"
                     PerMachine="$([System.String]::Equals('$(WindowsPackageScope)', 'perMachine'))"
                     InstallFolder="$(_WindowsInstallFolder)"
                     Architecture="$(_WindowsArch)"
                     IconFile="$(_WindowsIconFile)"
                     DesktopShortcut="$(WindowsPackageDesktopShortcut)"
                     Frameworks="@(_WindowsCheckFramework)"
                     OutputFile="$(_WindowsMsiFile)"
                     WorkDirectory="$(_WindowsWorkPath)msi" />
    <Exec Condition="'$(_WindowsSign)' == 'True'" Command="$(_WindowsSignCommand) &quot;$(_WindowsMsiFile)&quot;" EchoOff="True" StandardOutputImportance="low" />
    <Message Text="$(MSBuildProjectName) -> $(_WindowsMsiFile)" Importance="high" Condition="'$(_WindowsBuildMsi)' == 'True'" />
  </Target>

  <!-- Compiled with the .NET Framework compiler in Windows, so it needs nothing else to build or run -->
  <Target Name="_WindowsPackageSetup" Condition="'$(_WindowsBuildSetup)' == 'True'" DependsOnTargets="_WindowsPackageMsi">
    <PropertyGroup>
      <_WindowsSetupPath>$(_WindowsWorkPath)setup\</_WindowsSetupPath>
      <_WindowsCsc>$(windir)\Microsoft.NET\Framework\v4.0.30319\csc.exe</_WindowsCsc>
      <_WindowsSetupIcon Condition="'$(_WindowsIconFile)' != ''">/win32icon:&quot;$(_WindowsIconFile)&quot;</_WindowsSetupIcon>
    </PropertyGroup>
    <Error Text="The .NET Framework 4 C# compiler wasn't found at $(_WindowsCsc), which is needed to create setup." Condition="!Exists('$(_WindowsCsc)')" />
    <WriteSetupInfo OutputFile="$(_WindowsSetupPath)SetupInfo.cs"
                    Title="$(_WindowsTitle)"
                    Manufacturer="$(_WindowsManufacturer)"
                    Description="$(_WindowsDescription)"
                    Version="$(_WindowsVersion)"
                    InformationalVersion="$(InformationalVersion)"
                    Architecture="$(_WindowsArch)"
                    MsiName="$([System.IO.Path]::GetFileName('$(_WindowsMsiFile)'))"
                    Frameworks="@(_WindowsFramework)" />
    <Delete Files="$(_WindowsSetupFile)" />
    <Exec Command="&quot;$(_WindowsCsc)&quot; /nologo /noconfig /target:winexe /platform:anycpu /optimize+ /utf8output /out:&quot;$(_WindowsSetupFile)&quot; /win32manifest:&quot;$(MSBuildThisFileDirectory)WindowsSetup.manifest&quot; $(_WindowsSetupIcon) /resource:&quot;$(_WindowsMsiFile)&quot;,Setup.msi /reference:System.dll /reference:System.Drawing.dll /reference:System.Windows.Forms.dll &quot;$(MSBuildThisFileDirectory)WindowsSetup.cs&quot; &quot;$(_WindowsSetupPath)SetupInfo.cs&quot;"
          StandardOutputImportance="low" />
    <Exec Condition="'$(_WindowsSign)' == 'True'" Command="$(_WindowsSignCommand) &quot;$(_WindowsSetupFile)&quot;" EchoOff="True" StandardOutputImportance="low" />
    <Message Text="$(MSBuildProjectName) -> $(_WindowsSetupFile)" Importance="high" />
  </Target>

  <!-- .NET apps are packaged by an instance of this project for each runtime identifier -->
  <Target Name="_WindowsPackagePerRuntime" DependsOnTargets="_WindowsPackageInit"
          Condition="'$(_WindowsIsNetCore)' == 'True' AND '$(_WindowsRid)' == '' AND ('$(_WindowsBuildMsi)' == 'True' OR '$(_WindowsBuildSetup)' == 'True')">
    <ItemGroup>
      <_WindowsPackageRid Include="$(WindowsPackageRuntimeIdentifiers)" />
    </ItemGroup>
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_WindowsPackageRuntime"
             Properties="_WindowsRid=%(_WindowsPackageRid.Identity);_WindowsIsPackaging=True;Configuration=$(Configuration);TargetFramework=$(TargetFramework);WindowsPackageOnBuild=False" />
  </Target>

  <Target Name="_WindowsPackageRuntime" DependsOnTargets="_WindowsPackageInit;_WindowsPackageCreate" />

</Project>
