<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <UseGlobalUsings>false</UseGlobalUsings>
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Description>Compiles .xeto files into code</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(PortableXamlPath)' == ''">
    <PackageReference Include="Portable.Xaml" Version="0.31.0" GeneratePathProperty="true" />
    <PackageReference Include="Portable.Xaml.CodeGen" Version="0.31.0" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(PortableXamlPath)' != ''">
    <ProjectReference Include="$(PortableXamlPath)src\Portable.Xaml.CodeGen\Portable.Xaml.CodeGen.csproj" />
  </ItemGroup>

  <!-- the compiler loads analyzers from their own folder, so dependencies must go with the generator -->
  <PropertyGroup>
    <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetGeneratorDependencyTargetPaths</GetTargetPathDependsOn>
  </PropertyGroup>
  <Target Name="GetGeneratorDependencyTargetPaths">
    <ItemGroup Condition="'$(PortableXamlPath)' == ''">
      <TargetPathWithTargetPlatformMoniker Include="$(PkgPortable_Xaml)/lib/netstandard2.0/Portable.Xaml.dll" IncludeRuntimeDependency="false" />
      <TargetPathWithTargetPlatformMoniker Include="$(PkgPortable_Xaml_CodeGen)/lib/netstandard2.0/Portable.Xaml.CodeGen.dll" IncludeRuntimeDependency="false" />
    </ItemGroup>
    <ItemGroup Condition="'$(PortableXamlPath)' != ''">
      <TargetPathWithTargetPlatformMoniker Include="$(TargetDir)Portable.Xaml.dll" IncludeRuntimeDependency="false" />
      <TargetPathWithTargetPlatformMoniker Include="$(TargetDir)Portable.Xaml.CodeGen.dll" IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>
</Project>
