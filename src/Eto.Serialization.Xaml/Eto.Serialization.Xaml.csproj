<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <DefineConstants>$(DefineConstants);PORTABLE</DefineConstants>
  </PropertyGroup>
  
  <PropertyGroup>
    <PackageId>Eto.Serialization.Xaml</PackageId>
    <Title>Eto.Forms Xaml serializer</Title>
    <Description>Eto.Forms Xaml serializer</Description>
    <PackageTags>cross platform gui ui framework desktop xaml eto.forms</PackageTags>
    <PackageDescription>
Eto.Xaml allows you to load xaml UI definitions for the Eto.Forms framework

To get more information about how to get started, read the documentation:

https://eto.picoe.ca
    </PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Eto.Serialization.Xaml.targets" />
    <None Include="Eto.Serialization.Xaml.targets" Pack="true" PackagePath="build" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Eto\Eto.csproj" />
  </ItemGroup>
  
  <!-- ship the .xeto source generator, with the assemblies it loads, in the package's analyzers folder.
       Built only when packing (not a ProjectReference) so consumers' solutions needn't include the generator. -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeXamlGeneratorInPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="IncludeXamlGeneratorInPackage">
    <!-- the extra property forces a fresh evaluation, so Build sees the restore's output -->
    <MSBuild Projects="..\Eto.Serialization.Xaml.Generator\Eto.Serialization.Xaml.Generator.csproj" Targets="Restore" Properties="Configuration=$(Configuration);_XamlGeneratorRestore=true" RemoveProperties="TargetFramework" />
    <MSBuild Projects="..\Eto.Serialization.Xaml.Generator\Eto.Serialization.Xaml.Generator.csproj" Targets="Build" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework" />
    <!-- GetTargetPath also returns the Portable.Xaml dependencies the generator needs beside it -->
    <MSBuild Projects="..\Eto.Serialization.Xaml.Generator\Eto.Serialization.Xaml.Generator.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="_XamlGeneratorFile" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_XamlGeneratorFile)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <!-- set PortableXamlPath to a Portable.Xaml checkout to build against its source -->
  <ItemGroup Condition="'$(PortableXamlPath)' == ''">
    <PackageReference Include="Portable.Xaml" Version="0.31.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(PortableXamlPath)' != ''">
    <ProjectReference Include="$(PortableXamlPath)src\Portable.Xaml\Portable.Xaml.csproj" />
  </ItemGroup>
  
</Project>