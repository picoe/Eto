<?xml version="1.0" encoding="UTF-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="15.0">

  <ItemGroup Condition=" '$(EnableDefaultCompileItems)' == 'true' ">
    <None Remove="**\*.xeto" />
    <EmbeddedResource Include="**\*.xeto" />
  </ItemGroup>
  <!-- set EtoXamlCodeGen to true to compile .xeto files into their (partial) code-behind classes -->
  <PropertyGroup>
    <EtoXamlCodeGen Condition="'$(EtoXamlCodeGen)' == ''">False</EtoXamlCodeGen>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="EtoXamlCodeGen" />
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleProperty Include="ProjectDir" />
    <!-- XamlCodeGen="false" on a .xeto opts it out, "true" opts it in -->
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="XamlCodeGen" />
    <AdditionalFiles Include="@(EmbeddedResource->WithMetadataValue('Extension', '.xeto'))" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="**\*.xeto.cs">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
    <Compile Update="**\*.xeto.vb">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
    <Compile Update="**\*.xeto.fs">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>