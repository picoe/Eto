<?xml version="1.0" encoding="UTF-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="15.0">

  <!-- set EtoXamlJeto to true to embed (and compile) .jeto files for JetoReader -->
  <PropertyGroup>
    <EtoXamlJeto Condition="'$(EtoXamlJeto)' == ''">False</EtoXamlJeto>
  </PropertyGroup>

  <!-- include a file yourself to set metadata on it, e.g. <EmbeddedResource Include="MyForm.xeto" XamlCodeGen="false" /> -->
  <ItemGroup Condition=" '$(EnableDefaultCompileItems)' == 'true' ">
    <None Remove="**\*.xeto" />
    <EmbeddedResource Include="**\*.xeto" Exclude="@(EmbeddedResource)" />
  </ItemGroup>
  <!-- Eto.Serialization.Json may embed them too -->
  <ItemGroup Condition=" '$(EnableDefaultCompileItems)' == 'true' and '$(EtoXamlJeto)' == 'true' ">
    <None Remove="**\*.jeto" />
    <EmbeddedResource Include="**\*.jeto" Exclude="@(EmbeddedResource)" />
  </ItemGroup>
  <!-- set EtoXamlCodeGen to true to compile .xeto (and .jeto) files into their (partial) code-behind classes -->
  <PropertyGroup>
    <EtoXamlCodeGen Condition="'$(EtoXamlCodeGen)' == ''">False</EtoXamlCodeGen>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="EtoXamlCodeGen" />
    <!-- access of the fields generated for x:Name and ID, e.g. protected or internal; private when empty -->
    <CompilerVisibleProperty Include="EtoXamlFieldModifier" />
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleProperty Include="ProjectDir" />
    <!-- XamlCodeGen="false" on a file opts it out, "true" opts it in -->
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="XamlCodeGen" />
    <AdditionalFiles Include="@(EmbeddedResource->WithMetadataValue('Extension', '.xeto'))" />
    <AdditionalFiles Include="@(EmbeddedResource->WithMetadataValue('Extension', '.jeto'))" Condition="'$(EtoXamlJeto)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="**\*.xeto.cs">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
    <Compile Update="**\*.xeto.vb">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
    <Compile Update="**\*.xeto.fs">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup Condition="'$(EtoXamlJeto)' == 'true'">
    <Compile Update="**\*.jeto.cs">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
    <Compile Update="**\*.jeto.vb">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
    <Compile Update="**\*.jeto.fs">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
