<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:efc="clr-namespace:Eto.Wpf.Forms.Controls">


    <!--
    =========================================================================
    EtoComboBox - custom ControlTemplate
    =========================================================================
    The WPF default ComboBox template hard-codes gradient brushes in the
    toggle-button area (Aero / Classic chrome), so overriding SystemColors
    alone is not enough.  This template replaces the entire chrome with
    flat, DynamicResource-based brushes drawn from the palette so the
    control fully participates in the custom theme.
    =========================================================================
    -->

    <efc:RoundedClipConverter x:Key="EtoRoundedClipConverter" />

    <Style TargetType="{x:Type efc:EtoComboBox}">
        <Setter Property="Background"                 Value="{DynamicResource Eto.Palette.SurfaceBrush}" />
        <Setter Property="Foreground"                 Value="{DynamicResource Eto.Palette.ForegroundBrush}" />
        <Setter Property="BorderBrush"                Value="{DynamicResource Eto.Palette.BorderBrush}" />
        <Setter Property="BorderThickness"            Value="1" />
        <Setter Property="Padding"                    Value="{DynamicResource Eto.Palette.ControlPadding}" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll"              Value="True" />
        <Setter Property="FocusVisualStyle"           Value="{x:Null}" />
        <!-- Keep VirtualizingStackPanel so DropDownHandler's virtualization logic works -->
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type efc:EtoComboBox}">
                    <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <!-- Arrow column - fixed 20 px so FindMaxWidth() sees DesiredSize â‰ˆ 20 -->
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>

                        <!-- Outer border: provides background + ring -->
                        <Border x:Name="MainBorder"
                                Grid.ColumnSpan="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Eto.Palette.CornerRadius}" />

                        <!-- Toggle button spans the full area so the whole control is clickable.
                             Its inner template uses a star+20 grid, giving DesiredSize.Width â‰ˆ 20
                             which is what EtoComboBox.FindMaxWidth() expects. -->
                        <ToggleButton x:Name="toggleButton"
                                      Grid.ColumnSpan="2"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      ClickMode="Press"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}"
                                      OverridesDefaultStyle="True">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Grid Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Drop-down arrow glyph -->
                                        <Path Grid.Column="1"
                                              Data="M 0 0 L 3.5 4 L 7 0 Z"
                                              Fill="{DynamicResource Eto.Palette.ForegroundBrush}"
                                              Width="7" Height="4"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True" />
                                    </Grid>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Selected-item presenter (non-editable mode) -->
                        <ContentPresenter x:Name="ContentPresenter"
                                          Grid.Column="0"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          IsHitTestVisible="False"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                        <!-- Editable text box - only visible when IsEditable=True -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Grid.Column="0"
                                 Margin="{TemplateBinding Padding}"
                                 HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                 VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 BorderBrush="Transparent"
                                 Padding="0"
                                 Foreground="{TemplateBinding Foreground}"
                                 CaretBrush="{TemplateBinding Foreground}"
                                 SelectionBrush="{DynamicResource Eto.Palette.AccentBrush}"
                                 efc:EtoTextSelection.TextBrush="{DynamicResource Eto.Palette.AccentForegroundBrush}"
                                 SelectionOpacity="1"
                                 IsReadOnly="{Binding IsReadOnly,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                 Focusable="True"
                                 FocusVisualStyle="{x:Null}"
                                 Visibility="Hidden" />

                        <!-- Drop-down popup -->
                        <Popup x:Name="PART_Popup"
                               Grid.ColumnSpan="2"
                               AllowsTransparency="True"
                               IsOpen="{Binding IsDropDownOpen,
                                       RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom"
                               PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}">
                            <Border x:Name="DropDownBorder"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    MinWidth="{Binding ActualWidth,
                                               RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="{DynamicResource Eto.Palette.SurfaceBrush}"
                                    BorderBrush="{DynamicResource Eto.Palette.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Eto.Palette.CornerRadius}">
                                <!-- WPF's Border does not clip children to its CornerRadius, so the
                                     first/last item's hover/selection highlight would poke past the
                                     rounded corners. Clip this border to a rounded rectangle covering
                                     its own bounds so everything is clipped to the rounded shape.
                                     (A zero CornerRadius yields a plain rectangle, i.e. no-op.) -->
                                <Border.Clip>
                                    <MultiBinding Converter="{StaticResource EtoRoundedClipConverter}">
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                        <Binding Path="CornerRadius" RelativeSource="{RelativeSource Self}" />
                                    </MultiBinding>
                                </Border.Clip>
                                <ScrollViewer>
                                    <ItemsPresenter x:Name="ItemsPresenter"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Editable mode: swap presenter for text box -->
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentPresenter"     Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush"
                                    Value="{DynamicResource Eto.Palette.BorderHoverBrush}" />
                        </Trigger>
                        <!-- Keyboard focus within (e.g. editable text box focused) -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush"
                                    Value="{DynamicResource Eto.Palette.AccentBrush}" />
                        </Trigger>
                        <!-- Drop-down open -->
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush"
                                    Value="{DynamicResource Eto.Palette.AccentBrush}" />
                        </Trigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="MainBorder" Property="Background"
                                    Value="{DynamicResource Eto.Palette.DisabledBackgroundBrush}" />
                            <Setter TargetName="MainBorder" Property="BorderBrush"
                                    Value="{DynamicResource Eto.Palette.DisabledBorderBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Eto.Palette.DisabledForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
    =========================================================================
    ComboBoxItem - themed drop-down items
    =========================================================================
    The WPF default ComboBoxItem template draws the Aero highlight chrome
    (rounded gradient border + system Highlight background/foreground) which
    ignores the palette. This flat template replaces it with palette brushes:
    the currently-selected item gets a subtle fill, and the item under the
    mouse / keyboard highlight gets the accent color. Used by both DropDown
    and ComboBox (both are EtoComboBox with ComboBoxItem containers).
    =========================================================================
    -->
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background"                 Value="Transparent" />
        <Setter Property="Foreground"                 Value="{DynamicResource Eto.Palette.ForegroundBrush}" />
        <Setter Property="Padding"                    Value="6,3" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="SnapsToDevicePixels"        Value="True" />
        <Setter Property="FocusVisualStyle"           Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Currently-selected item (visible while scrolling the open list) -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background"
                                    Value="{DynamicResource Eto.Palette.HoverBackgroundBrush}" />
                        </Trigger>
                        <!-- Mouse-over / keyboard highlight wins over selection -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background"
                                    Value="{DynamicResource Eto.Palette.AccentBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Eto.Palette.AccentForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Eto.Palette.DisabledForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
