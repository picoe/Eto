<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:efc="clr-namespace:Eto.Wpf.Forms.Controls">

    <!--
    =========================================================================
    EtoButton - custom ControlTemplate for the custom theme
    =========================================================================
    The WPF default Button template (Aero / Classic) uses hard-coded
    LinearGradientBrush chrome that ignores SystemColors overrides.
    This template replaces that chrome with flat, DynamicResource-based
    brushes from the palette so the button fully participates in the
    custom theme.
    =========================================================================
    -->

    <Style x:Key="EtoButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background"      Value="{DynamicResource Eto.Palette.SurfaceBrush}" />
        <Setter Property="Foreground"      Value="{DynamicResource Eto.Palette.ForegroundBrush}" />
        <Setter Property="BorderBrush"     Value="{DynamicResource Eto.Palette.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding"         Value="{DynamicResource Eto.Palette.ButtonPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type efc:EtoButton}">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Eto.Palette.CornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="ContentPresenter"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{DynamicResource Eto.Palette.HoverBackgroundBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush"
                                    Value="{DynamicResource Eto.Palette.HoverBorderBrush}" />
                        </Trigger>
                        <!-- Pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{DynamicResource Eto.Palette.PressedBackgroundBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush"
                                    Value="{DynamicResource Eto.Palette.PressedBorderBrush}" />
                        </Trigger>
                        <!-- Keyboard focused -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush"
                                    Value="{DynamicResource Eto.Palette.AccentBrush}" />
                        </Trigger>
                        <!-- Default button (AcceptButton) -->
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush"
                                    Value="{DynamicResource Eto.Palette.AccentBrush}" />
                        </Trigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{DynamicResource Eto.Palette.DisabledBackgroundBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush"
                                    Value="{DynamicResource Eto.Palette.DisabledBorderBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Eto.Palette.DisabledForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type efc:EtoButton}" BasedOn="{StaticResource EtoButtonStyle}" />

</ResourceDictionary>
