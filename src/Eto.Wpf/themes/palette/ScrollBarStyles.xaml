<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    =========================================================================
    Shared ScrollBar styles for the custom theme
    =========================================================================
    Provides themed scrollbar chrome (thumb, arrows, track) using palette
    DynamicResource brushes.  Merged by EtoScrollViewer.xaml and applied
    globally via a ScrollBar style so every control that embeds a ScrollViewer
    (ListBox, DataGrid, RichTextBox, TextBox, ComboBox popup, â€¦) picks up
    the themed scrollbars automatically.
    =========================================================================
    -->

    <!-- == Repeat-button for the track background (transparent, no chrome) == -->
    <Style x:Key="EtoScrollBarPageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background"  Value="Transparent" />
        <Setter Property="Focusable"   Value="False" />
        <Setter Property="IsTabStop"   Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- == Thumb ============================================================ -->
    <Style x:Key="EtoScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbBorder"
                            Background="{DynamicResource Eto.Palette.BorderBrush}"
                            CornerRadius="3"
                            Margin="1" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background"
                                    Value="{DynamicResource Eto.Palette.BorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background"
                                    Value="{DynamicResource Eto.Palette.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- == Arrow line-button (top/bottom/left/right) ======================= -->
    <Style x:Key="EtoScrollBarLineButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border x:Name="ArrowBorder"
                            Background="{DynamicResource Eto.Palette.SurfaceBrush}"
                            SnapsToDevicePixels="True">
                        <Path x:Name="Arrow"
                              Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                              Fill="{DynamicResource Eto.Palette.SubtleForegroundBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Width="8" Height="6"
                              Stretch="Uniform"
                              SnapsToDevicePixels="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Arrow" Property="Fill"
                                    Value="{DynamicResource Eto.Palette.ForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Arrow" Property="Fill"
                                    Value="{DynamicResource Eto.Palette.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- == Vertical ScrollBar template ===================================== -->
    <ControlTemplate x:Key="EtoVerticalScrollBar" TargetType="{x:Type ScrollBar}">
        <Border Background="{DynamicResource Eto.Palette.BackgroundBrush}"
                BorderBrush="{DynamicResource Eto.Palette.BorderBrush}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition MaxHeight="14" />
                    <RowDefinition />
                    <RowDefinition MaxHeight="14" />
                </Grid.RowDefinitions>
                <RepeatButton Grid.Row="0"
                              Style="{StaticResource EtoScrollBarLineButton}"
                              Command="ScrollBar.LineUpCommand"
                              Content="M 0 4 L 4 0 L 8 4 Z" />
                <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource EtoScrollBarPageButton}"
                                      Command="ScrollBar.PageUpCommand" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource EtoScrollBarThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource EtoScrollBarPageButton}"
                                      Command="ScrollBar.PageDownCommand" />
                    </Track.IncreaseRepeatButton>
                </Track>
                <RepeatButton Grid.Row="2"
                              Style="{StaticResource EtoScrollBarLineButton}"
                              Command="ScrollBar.LineDownCommand"
                              Content="M 0 0 L 4 4 L 8 0 Z" />
            </Grid>
        </Border>
    </ControlTemplate>

    <!-- == Horizontal ScrollBar template =================================== -->
    <ControlTemplate x:Key="EtoHorizontalScrollBar" TargetType="{x:Type ScrollBar}">
        <Border Background="{DynamicResource Eto.Palette.BackgroundBrush}"
                BorderBrush="{DynamicResource Eto.Palette.BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MaxWidth="14" />
                    <ColumnDefinition />
                    <ColumnDefinition MaxWidth="14" />
                </Grid.ColumnDefinitions>
                <RepeatButton Grid.Column="0"
                              Style="{StaticResource EtoScrollBarLineButton}"
                              Command="ScrollBar.LineLeftCommand"
                              Content="M 4 0 L 0 4 L 4 8 Z" />
                <Track x:Name="PART_Track" Grid.Column="1" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource EtoScrollBarPageButton}"
                                      Command="ScrollBar.PageLeftCommand" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource EtoScrollBarThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource EtoScrollBarPageButton}"
                                      Command="ScrollBar.PageRightCommand" />
                    </Track.IncreaseRepeatButton>
                </Track>
                <RepeatButton Grid.Column="2"
                              Style="{StaticResource EtoScrollBarLineButton}"
                              Command="ScrollBar.LineRightCommand"
                              Content="M 0 0 L 4 4 L 0 8 Z" />
            </Grid>
        </Border>
    </ControlTemplate>

    <!-- == Global ScrollBar style ========================================== -->
    <!-- Applies to ALL ScrollBar instances so every control that contains a
         ScrollViewer (ListBox, DataGrid, RichTextBox, TextBox, ComboBox
         popup, TreeView, â€¦) gets themed scrollbars automatically. -->
    <Style TargetType="{x:Type ScrollBar}">
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource EtoVerticalScrollBar}" />
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource EtoHorizontalScrollBar}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
