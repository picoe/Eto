{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src/Eto",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
	  "output": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}",
		  "../README.md"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
		  "favicon.ico"
        ]
      }
    ],
    "output": "../artifacts/docs/_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Eto.Forms",
      "_appTitle": "Eto.Forms",
      "_enableSearch": true,
	  "_appFaviconPath": "favicon.ico",
	  "_appLogoPath": "images/logo.svg"
    }
	
  }
}