<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    =========================================================================
    MIDNIGHT BLUE PALETTE  (dark)
    =========================================================================
    A deep navy palette for Eto.Wpf's palette theme (themes/palette.xaml).
    See Palette.xaml for a description of each key.
    =========================================================================
    -->

    <!-- ── Backgrounds ─────────────────────────────────────────────────── -->
    <Color x:Key="Eto.Palette.Background.Color">#0E1726</Color>
    <Color x:Key="Eto.Palette.Surface.Color">#0A111D</Color>

    <!-- ── Foregrounds ──────────────────────────────────────────────────── -->
    <Color x:Key="Eto.Palette.Foreground.Color">#D6E2F1</Color>
    <Color x:Key="Eto.Palette.SubtleForeground.Color">#64748B</Color>
    <Color x:Key="Eto.Palette.DisabledForeground.Color">#3B4A61</Color>

    <!-- ── Borders ───────────────────────────────────────────────────────── -->
    <Color x:Key="Eto.Palette.Border.Color">#22304A</Color>
    <Color x:Key="Eto.Palette.BorderHover.Color">#3A527A</Color>

    <!-- ── Accent / Focus ────────────────────────────────────────────────── -->
    <Color x:Key="Eto.Palette.Accent.Color">#5B9DFF</Color>
    <Color x:Key="Eto.Palette.AccentHover.Color">#7DB4FF</Color>
    <Color x:Key="Eto.Palette.AccentPressed.Color">#4489E8</Color>
    <Color x:Key="Eto.Palette.AccentForeground.Color">#0A111D</Color>

    <!-- ── Interactive States ─────────────────────────────────────────────── -->
    <Color x:Key="Eto.Palette.CheckedBackground.Color">#23364F</Color>
    <Color x:Key="Eto.Palette.CheckedBorder.Color">#5B9DFF</Color>
    <Color x:Key="Eto.Palette.HoverBackground.Color">#1A2739</Color>
    <Color x:Key="Eto.Palette.HoverBorder.Color">#3A527A</Color>
    <Color x:Key="Eto.Palette.PressedBackground.Color">#23364F</Color>
    <Color x:Key="Eto.Palette.PressedBorder.Color">#5B9DFF</Color>
    <Color x:Key="Eto.Palette.DisabledBackground.Color">#0A111D</Color>
    <Color x:Key="Eto.Palette.DisabledBorder.Color">#22304A</Color>

    <!-- ═ Brushes — derived from the colors above ═══════════════════════════ -->
    <SolidColorBrush x:Key="Eto.Palette.BackgroundBrush"         Color="{StaticResource Eto.Palette.Background.Color}" />
    <SolidColorBrush x:Key="Eto.Palette.SurfaceBrush"            Color="{StaticResource Eto.Palette.Surface.Color}" />
    <SolidColorBrush x:Key="Eto.Palette.ForegroundBrush"         Color="{StaticResource Eto.Palette.Foreground.Color}" />
    <SolidColorBrush x:Key="Eto.Palette.SubtleForegroundBrush"   Color="{StaticResource Eto.Palette.SubtleForeground.Color}" />
    <SolidColorBrush x:Key="Eto.Palette.DisabledForegroundBrush" Color="{StaticResource Eto.Palette.DisabledForeground.Color}" />

    <SolidColorBrush x:Key="Eto.Palette.BorderBrush"             Color="{StaticResource Eto.Palette.Border.Color}" />
    <SolidColorBrush x:Key="Eto.Palette.BorderHoverBrush"        Color="{StaticResource Eto.Palette.BorderHover.Color}" />

    <SolidColorBrush x:Key="Eto.Palette.AccentBrush"             Color="{StaticResource Eto.Palette.Accent.Color}" />
    <SolidColorBrush x:Key="Eto.Palette.AccentHoverBrush"        Color="{StaticResource Eto.Palette.AccentHover.Color}" />
    <SolidColorBrush x:Key="Eto.Palette.AccentPressedBrush"      Color="{StaticResource Eto.Palette.AccentPressed.Color}" />
    <SolidColorBrush x:Key="Eto.Palette.AccentForegroundBrush"   Color="{StaticResource Eto.Palette.AccentForeground.Color}" />

    <SolidColorBrush x:Key="Eto.Palette.CheckedBackgroundBrush"  Color="{StaticResource Eto.Palette.CheckedBackground.Color}" />
    <SolidColorBrush x:Key="Eto.Palette.CheckedBorderBrush"      Color="{StaticResource Eto.Palette.CheckedBorder.Color}" />
    <SolidColorBrush x:Key="Eto.Palette.HoverBackgroundBrush"    Color="{StaticResource Eto.Palette.HoverBackground.Color}" />
    <SolidColorBrush x:Key="Eto.Palette.HoverBorderBrush"        Color="{StaticResource Eto.Palette.HoverBorder.Color}" />
    <SolidColorBrush x:Key="Eto.Palette.PressedBackgroundBrush"  Color="{StaticResource Eto.Palette.PressedBackground.Color}" />
    <SolidColorBrush x:Key="Eto.Palette.PressedBorderBrush"      Color="{StaticResource Eto.Palette.PressedBorder.Color}" />
    <SolidColorBrush x:Key="Eto.Palette.DisabledBackgroundBrush" Color="{StaticResource Eto.Palette.DisabledBackground.Color}" />
    <SolidColorBrush x:Key="Eto.Palette.DisabledBorderBrush"     Color="{StaticResource Eto.Palette.DisabledBorder.Color}" />

    <!-- == Shape / spacing (optional) ====================================== -->
    <!-- This palette opts into a slightly larger corner radius than Mocha to show
         the value is per-palette. See themes/palette.xaml for the defaults. -->
    <CornerRadius x:Key="Eto.Palette.CornerRadius">8</CornerRadius>
    <Thickness x:Key="Eto.Palette.ControlPadding">9,5</Thickness>
    <Thickness x:Key="Eto.Palette.ButtonPadding">14,6</Thickness>

    <!-- == Menu bar / tool bar (optional) =================================== -->
    <!-- By default both blend into the window (window background, no border).
         This palette opts into distinct chrome instead: the darker inset surface
         with a separator line under each bar. Mocha and Latte leave these keys
         alone, so they keep the blended default. -->
    <SolidColorBrush x:Key="Eto.Palette.MenuBarBackgroundBrush"  Color="{StaticResource Eto.Palette.Surface.Color}" />
    <SolidColorBrush x:Key="Eto.Palette.MenuBarBorderBrush"      Color="{StaticResource Eto.Palette.Border.Color}" />
    <Thickness x:Key="Eto.Palette.MenuBarBorderThickness">0,0,0,1</Thickness>

    <SolidColorBrush x:Key="Eto.Palette.ToolBarBackgroundBrush"  Color="{StaticResource Eto.Palette.Surface.Color}" />
    <SolidColorBrush x:Key="Eto.Palette.ToolBarBorderBrush"      Color="{StaticResource Eto.Palette.Border.Color}" />
    <Thickness x:Key="Eto.Palette.ToolBarBorderThickness">0,0,0,1</Thickness>

    <!-- Keep the WPF system key in sync for any plain (non-Eto) menu -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="{StaticResource Eto.Palette.Surface.Color}" />

</ResourceDictionary>
