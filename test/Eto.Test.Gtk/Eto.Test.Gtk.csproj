<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <DefineConstants>$(DefineConstants);CAIRO;GTK3</DefineConstants>
    <TreatWarningsAsErrors Condition="$(Configuration) == 'Release'">true</TreatWarningsAsErrors>
	<RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <!-- installer packages are only built (and uploaded by CI) from Linux builds -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform(Linux))">
    <LinuxPackageFormats>deb;rpm;tar.gz;appimage</LinuxPackageFormats>
    <LinuxIcon>..\Eto.Test\Images\TestIcon.ico</LinuxIcon>
    <LinuxPackageLicense>BSD-3-Clause</LinuxPackageLicense>
    <LinuxPackageRuntimeIdentifiers>linux-x64;linux-arm64</LinuxPackageRuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(RunConfiguration)' == 'Default' ">
    <StartAction>Project</StartAction>
    <ExternalConsole>false</ExternalConsole>
    <EnvironmentVariables>
      <Variable name="LD_LIBRARY_PATH" value="/usr/local/lib:/usr/lib" />
    </EnvironmentVariables>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Eto.Gtk\Eto.Gtk.csproj" />
    <ProjectReference Include="..\..\src\Eto\Eto.csproj" />
    <ProjectReference Include="..\Eto.Test\Eto.Test.csproj" />
  </ItemGroup>
  <Import Project="..\..\src\Eto.Gtk\build\Gtk.targets" />
</Project>
